{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KORDRA Desktop Preview",
  "version": "0.1.0",
  "identifier": "id.vn.kordra.desktop.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KORDRA Control Plane Preview",
        "width": 1440,
        "height": 960,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://ipc.localhost https://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": { "active": false }
}
