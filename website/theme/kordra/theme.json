{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1320px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "color": "#000000", "name": "Ink" },
        { "slug": "surface", "color": "#101317", "name": "Raised surface" },
        { "slug": "paper", "color": "#f3f2ed", "name": "Paper" },
        { "slug": "muted", "color": "#b3bbc1", "name": "Muted text" },
        { "slug": "line", "color": "#33393e", "name": "Thin border" },
        { "slug": "soft-line", "color": "#23282c", "name": "Soft line" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingScale": {
        "operator": "+",
        "increment": 0.25,
        "steps": 7,
        "mediumStep": 1,
        "unit": "rem"
      },
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "0.75rem", "name": "S" },
        { "slug": "40", "size": "1rem", "name": "M" },
        { "slug": "50", "size": "1.5rem", "name": "L" },
        { "slug": "60", "size": "2rem", "name": "XL" },
        { "slug": "70", "size": "3rem", "name": "2XL" },
        { "slug": "80", "size": "4.5rem", "name": "3XL" }
      ],
      "units": ["px", "rem", "vw", "%"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"IBM Plex Sans\", sans-serif",
          "name": "IBM Plex Sans",
          "slug": "ibm-plex-sans",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-sans-latin.woff2"]
            }
          ]
        },
        {
          "fontFamily": "\"IBM Plex Mono\", monospace",
          "name": "IBM Plex Mono",
          "slug": "ibm-plex-mono",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-mono-latin.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.375rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra large" },
        { "slug": "xx-large", "size": "3rem", "name": "Display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ink",
      "text": "var:preset|color|paper"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "0",
        "right": "0"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|ibm-plex-sans",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": { "text": "var:preset|color|paper" },
        "typography": {
          "fontFamily": "var:preset|font-family|ibm-plex-sans",
          "fontWeight": "700",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|paper" },
        "typography": { "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var:preset|color|muted" },
          "typography": { "textDecoration": "underline" }
        },
        ":focus": {
          "outline": { "color": "var:preset|color|paper", "style": "solid", "width": "2px" }
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": { "fontWeight": "700", "lineHeight": "1.15" }
      },
      "core/site-title": {
        "typography": { "fontWeight": "700", "letterSpacing": "0.04em" }
      }
    }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "KORDRA header" },
    { "area": "footer", "name": "footer", "title": "KORDRA footer" }
  ]
}
